# ---- Sleeper (no auth needed) ----
SLEEPER_USERNAME=your_sleeper_username

# ---- ESPN (private league: copy cookies from fantasy.espn.com while logged in) ----
# League ID is in the URL: https://fantasy.espn.com/football/team?leagueId=XXXXXX
ESPN_LEAGUE_ID=
# DevTools -> Application -> Cookies -> fantasy.espn.com -> espn_s2 and SWID (keep the braces on SWID)
ESPN_S2=
ESPN_SWID={XXXXXXXX-XXXX-XXXX-XXXX-XXXXXXXXXXXX}
# Optional: only needed if owner matching by SWID fails
ESPN_TEAM_ID=

# ---- Yahoo (needs an OAuth app; see README) ----
# Optional: numeric league id from the Yahoo URL. Leave blank to use your first NFL league.
YAHOO_LEAGUE_ID=
# Path to the oauth2.json holding consumer_key / consumer_secret (tokens get written back to it)
YAHOO_OAUTH_FILE=oauth2.json

# Optional: force a season instead of reading it from Sleeper's NFL state
SEASON_OVERRIDE=
